{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver",
    ":pinDependencies",
    ":pinDevDependencies"
  ],
  "minimumReleaseAge": "10 days",
  "packageRules": [
    {
      "description": "Weekly cooldown for container images in lieu of release timestamps",
      "matchCategories": [
        "docker"
      ],
      "minimumReleaseAge": null,
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "description": "Group the version-coupled OpenCode stack: @opencode/plugin pins exact optional @opentui peers, @opentui/solid needs the same @opentui/core version, and the pinned @opencode/cli host must match the plugin line, so npm cannot resolve a partial update of the family",
      "groupName": "opencode stack",
      "matchPackageNames": [
        "@opencode/**",
        "@opentui/**"
      ],
      "separateMajorMinor": false
    },
    {
      "description": "Cap @opentui updates to the 0.7.x line: no @opencode/plugin release accepts @opentui 0.8.x peers yet, so updates beyond 0.7.x fail with ERESOLVE; remove this rule when a @opencode/plugin release accepts @opentui 0.8.x peers",
      "matchPackageNames": [
        "@opentui/**"
      ],
      "allowedVersions": "0.7.x"
    },
    {
      "description": "Group Node.js version updates for .nvmrc and the GitHub Actions setup-node input into one branch, including major updates",
      "groupName": "Node.js",
      "matchManagers": [
        "nvm",
        "github-actions"
      ],
      "matchPackageNames": [
        "node",
        "actions/node-versions"
      ],
      "matchDatasources": [
        "node-version",
        "github-releases"
      ],
      "separateMajorMinor": false
    },
    {
      "description": "Automatically rebase PRs modifying workflow files when out of date",
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "rebaseWhen": "behind-base-branch"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days",
    "labels": [
      "dependencies",
      "security"
    ]
  }
}
