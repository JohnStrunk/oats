{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver",
    ":pinDependencies",
    ":pinDevDependencies"
  ],
  "minimumReleaseAge": "10 days",
  "packageRules": [
    {
      "description": "Weekly cooldown for container images in lieu of release timestamps",
      "matchCategories": [
        "docker"
      ],
      "minimumReleaseAge": null,
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "description": "Group Node.js version updates for .nvmrc and the GitHub Actions setup-node input into one branch, including major updates",
      "groupName": "Node.js",
      "matchManagers": [
        "nvm",
        "github-actions"
      ],
      "matchPackageNames": [
        "node",
        "actions/node-versions"
      ],
      "matchDatasources": [
        "node-version",
        "github-releases"
      ],
      "separateMajorMinor": false
    },
    {
      "description": "Automatically rebase PRs modifying workflow files when out of date",
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "rebaseWhen": "behind-base-branch"
    }
  ],
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days",
    "labels": [
      "dependencies",
      "security"
    ]
  }
}
